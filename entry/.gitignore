/node_modules
/oh_modules
/.preview
/build/*
# 仅放行发布需要的未签名 HAP；其余 build 产物继续忽略
!/build/default/
/build/default/*
!/build/default/outputs/
/build/default/outputs/*
!/build/default/outputs/default/
/build/default/outputs/default/*
!/build/default/outputs/default/entry-default-unsigned.hap
# 签名包严禁入库；release 产物不入库（含未签名），统一用 default 未签名包发布
/build/release/
/build/**/*-signed.hap
/.cxx
/.test